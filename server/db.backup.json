  "posts": [
    {
      "id": 1,
      "userId": 1,
      "title": "הכלב שלי גילה את הים לראשונה",
      "body": "לקחנו את רקס לחוף בפעם הראשונה. בהתחלה הוא פחד מהגלים, ואחרי עשר דקות כבר לא הצלחנו להוציא אותו מהמים."
    },
    {
      "id": 2,
      "userId": 2,
      "title": "החתול שלי ישן רק בקופסאות",
      "body": "קנינו לו מיטה יקרה, והוא בוחר כל פעם מחדש בקופסת הקרטון שהמיטה הגיעה בה."
    },
    {
      "id": 3,
      "userId": 3,
      "title": "מה ארנבים אוהבים לאכול",
      "body": "חציר, הרבה חציר. ירקות עליים בכמות קטנה, ופירות רק כפינוק."
    },
    {
      "id": 4,
      "userId": 1,
      "title": "איך לגרום לחתול לאהוב את הרצועה",
      "body": "התחלנו עם חמש דקות ביום בתוך הבית, עם חטיף קטן אחרי כל צעד. אחרי שבוע כבר יצאנו לחצר ושניהם חזרו מרוצים."
    },
    {
      "id": 5,
      "userId": 2,
      "title": "טיפים לטיפוח פרווה בחורף",
      "body": "סירוק יומי קצר עוזר למנוע קשרים, וגם מפחית את כמות השיער על הספה."
    },
    {
      "id": 6,
      "userId": 3,
      "title": "הארנב שלי למד לבוא כשקוראים לו",
      "body": "עם עלה חסה ביד וקצת סבלנות, אחרי שבועיים שוקו כבר מגיע בריצה."
    },
    {
      "id": 7,
      "userId": 1,
      "title": "טיפים להאכלת ארנבים",
      "body": "חשוב שיהיה חציר זמין כל הזמן ומים טריים. ירקות חדשים מכניסים בהדרגה."
    },
    {
      "id": 8,
      "userId": 2,
      "title": "משחקים עם חתול בבית",
      "body": "מוט עם נוצה, כדור נייר וקצת זמן פנוי. זה כל מה שצריך לחצי שעה של כיף."
    },
    {
      "id": 9,
      "userId": 1,
      "title": "ביקור ראשון אצל הווטרינר",
      "body": "הבאנו חטיפים ושמיכה מהבית, וזה עזר לרקס להירגע בחדר ההמתנה."
    },
    {
      "id": 10,
      "userId": 3,
      "title": "איך לבנות לארנב פינת משחק",
      "body": "מנהרת קרטון, כמה קופסאות ושטיח שלא מחליק. הוא לא יוצא משם."
    },
    {
      "id": 11,
      "userId": 2,
      "title": "חתול ומזגן: מה עושים בקיץ",
      "body": "דואגים שתמיד תהיה לו פינה מוצלת ומים קרים, ולא מכוונים את המזגן ישר עליו."
    },
    {
      "id": 12,
      "userId": 1,
      "title": "התוכי למד מילה חדשה",
      "body": "אחרי חודש של חזרות, התוכי אומר עכשיו \"בוקר טוב\" כל פעם שמישהו נכנס למטבח."
    }
  ],
